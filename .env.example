# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored -- never commit real secrets.

# Secret used by Flask to sign session cookies. Required, login will not work without it.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
DB_KEY=change-me

# Largest file people can upload (photos and videos), in MB. Optional, defaults to 50.
# Behind Cloudflare (the tunnel below), keep it at 100 or less: Cloudflare's Free and
# Pro plans reject request bodies over 100 MB before they reach the server.
MAX_UPLOAD_MB=50

# Only needed for the production docker compose setup (Cloudflare tunnel)
TUNNEL_TOKEN=
