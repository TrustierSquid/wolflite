# The Docker build context is the repo root (see server/Dockerfile).
# Keep it small, and never send secrets or live data into the image.

# Git / CI / editor
.git
.github
.gitignore
.vscode
docs
*.md

# Secrets and live data
.env
**/.env
data
uploads
**/instance
**/static/uploads
*.sqlite
*.db

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
server/static/dist
client/wolflite/dist

# Logs / OS files
*.log
.DS_Store
Thumbs.db
